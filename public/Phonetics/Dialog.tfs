var MUST_BE_RIGHT=5;
var q_array = new Array();
var cur_question = -1;

var num_right = 0;
var num_wrong = 0;

function do_a_concept( concept_num )
    {
    switch( concept_num )
        {
	"0"	{
		html " Phonetic codes: <pre>  Alpha    Beta     Charlie<br>  Delta    Echo     Foxtrot<br>  Golf     Hotel    Indigo<br>  Juliet   Kilo     Lima<br>  Mike     November Oscar<br>  Poppa    Quebec   Romeo<br>  Sierra   Tango    Uniform<br>  Victor   Whiskey  X-ray<br>  Yankee   Zulu </pre> ";
		}

	"1"	{
		html " ";
		}

	}
    }

function right_wrong( answer, right_answer, concept_num )
    {
    if( answer )
        {
	if( answer == right_answer )
	    {
	    html "<center>Right!</center><hr>";
	    cur_question = next_question();
	    num_right++;
	    }
	else
	    {
	    html "<center>Wrong!</center><hr>";
	    do_a_concept( concept_num );
	    html "<hr>";
	    num_wrong++;
	    }
	}
    }

function setup_questions()
    {
    for ( var question_ctr=26; question_ctr-->0; )
        {
	for( var i=0; i<MUST_BE_RIGHT; i++ )
	    { q_array.push( question_ctr ); }
	}
    }

function next_question()
    {
    var q_ind = Math.floor( Math.random() * q_array.length );
    var ind = q_array[ q_ind ];
    q_array[ q_ind ] = q_array.pop();
    return ind;
    }

function redraw()
    {
    if( cur_question < 0 )
        {
	cur_question = next_question();
	}
    switch { cur_question }
        {
	"0"	{
		right_wrong( Phonetic_code_for_A, "Alpha", 0 );
